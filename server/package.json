{
  "name": "ler-mais-server",
  "version": "0.1.0",
  "description": "Backend do jogo Ler+ (Fastify + Prisma + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../.env.local --watch src/index.js",
    "start": "node src/index.js",
    "postinstall": "prisma generate",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=../.env.local src/scripts/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file-if-exists=.env --env-file-if-exists=../.env.local node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file-if-exists=.env --env-file-if-exists=../.env.local node_modules/prisma/build/index.js migrate deploy",
    "prisma:studio": "node --env-file-if-exists=.env --env-file-if-exists=../.env.local node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.19.0",
    "fastify": "^4.28.1",
    "prisma": "^5.19.0"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
