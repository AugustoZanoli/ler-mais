# Conexão com o PostgreSQL.
# Ajuste usuário, senha, host, porta e nome do banco conforme o seu ambiente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ler_mais?schema=public"

# Porta do servidor HTTP.
PORT=3333

# Origem permitida no CORS (o front do Vite).
CORS_ORIGIN="http://localhost:5173"

# Google Books API. Gere em https://console.cloud.google.com (ative "Books API").
GOOGLE_BOOKS_API_KEY="sua-chave-aqui"
# País usado nas consultas (afeta disponibilidade dos volumes).
GOOGLE_BOOKS_COUNTRY="BR"
